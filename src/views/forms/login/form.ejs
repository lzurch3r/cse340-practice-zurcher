<%- include('../../partials/header') %>
<main>
    <h1><%= title %></h1>
    <p>
        Enter your email and password to access your account. Do not have an account? <a href="/register">Register here</a>.
    </p>

    <form method="POST" action="/login" class="login-form">
        <!-- Email field -->
        <div class="form-group">
            <!-- COMPLETE: Add label for email -->
            <!-- COMPLETE: Add input type="email" with id, name, and required -->
            <!-- COMPLETE: Add appropriate placeholder text -->
            <label for="email">E-mail</label>
            <input type="email" id="email" name="email" placeholder="E-mail" required>
        </div>

        <!-- Password field -->
        <!-- COMPLETE: Create form-group div -->
        <!-- COMPLETE: Add label for password -->
        <!-- COMPLETE: Add input type="password" with id, name, minlength="8", and required -->
        <!-- COMPLETE: Add appropriate placeholder text -->
        <div class="form-group">
           <label for="password">Password</label>
           <input type="password" id="password" name="password" minlength="8" placeholder="Password" required>
        </div>

        <!-- Submit button -->
        <!-- COMPLETE: Add button type="submit" with text "Sign In" or "Login" -->
        <button type="submit">Sign In</button>

        <div class="form-footer">
            <p>New user? <a href="/register">Create an account</a></p>
        </div>
    </form>
</main>
<%- include('../../partials/footer') %>