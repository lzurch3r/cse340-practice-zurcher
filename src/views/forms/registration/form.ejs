<%- include('../../partials/header') %>
<main>
    <h1><%= title %></h1>
    <p>
        Register for a new account by providing your information below. All fields are required and passwords must meet security requirements.
    </p>

    <form method="POST" action="/register" class="registration-form">
        <!-- Name field -->
        <div class="form-group">
            <!-- COMPLETE: Add label for="name" -->
            <!-- COMPLETE: Add input type="text" id="name" name="name" -->
            <!-- COMPLETE: Add minlength="2" and required attributes -->
            <!-- COMPLETE: Add appropriate placeholder text -->
            <label for="name">Name</label>
            <input type="text" id="name" name="name"
            minlength="2" placeholder="Name" required>
        </div>

        <!-- Email field -->
        <!-- COMPLETE: Create form-group div -->
        <!-- COMPLETE: Add label for email -->
        <!-- COMPLETE: Add input type="email" with id, name, and required -->
        <div class="form-group">
            <label for="email">E-mail</label>
            <input type="email" id="email" name="email" placeholder="E-mail" required>
        </div>

        <!-- Email confirmation field -->
        <!-- COMPLETE: Create form-group div for emailConfirm -->
        <!-- COMPLETE: Should match email field structure -->
        <!-- COMPLETE: Use name="emailConfirm" -->
        <div class="form-group">
            <label for="emailConfirm">Confirm E-mail</label>
            <input type="email" id="emailConfirm" name="emailConfirm" placeholder="Confirm E-mail" required>
        </div>

        <!-- Password field -->
        <!-- COMPLETE: Create form-group div -->
        <!-- COMPLETE: Add label for password -->
        <!-- COMPLETE: Add input type="password" -->
        <!-- COMPLETE: Add minlength="8" and required attributes -->
        <!-- COMPLETE: Add pattern="(?=.*[0-9])(?=.*[!@#$%^&*]).*" for validation -->
        <!-- COMPLETE: Add a div with class="help-text" explaining requirements -->
        <!-- HINT: "Must be at least 8 characters with a number and special character" -->
        <div class="form-group">
            <label for="password">Password</label>
            <input type="password" id="password" name="password" minlength="8" pattern="(?=.*[0-9])(?=.*[!@#$%^&*]).*" required>
            <div class="help-text">Must be at least 8 characters with a number and special character</div>
        </div>

        <!-- Password confirmation field -->
        <!-- COMPLETE: Similar to password field but for passwordConfirm -->
        <!-- COMPLETE: Use name="passwordConfirm" and appropriate label -->
        <div class="form-group">
            <label for="passwordConfirm">Confirm Password</label>
            <input type="password" id="passwordConfirm" name="passwordConfirm" minlength="8" pattern="(?=.*[0-9])(?=.*[!@#$%^&*]).*" required>
        </div>

        <!-- Submit button -->
        <!-- COMPLETE: Add button type="submit" with text like "Create Account" -->
        <button type="submit">Create Account</button>
    </form>
</main>
<%- include('../../partials/footer') %>